@echo off
chcp 65001 >nul
title DIAI 프로그램 구동기

echo ========================================================
echo   DIAI 구동기
echo ========================================================
echo.

echo [1/3] 기존에 실행 중인 AI 프로세스를 재정렬합니다...
:: 윈도우 트레이에 미리 켜져 있어 설정을 방해하는 기본 Ollama를 강제 종료합니다.
taskkill /f /im ollama.exe >nul 2>&1

:: 웹 브라우저(HTML)에서 AI 엔진에 접근할 수 있도록 문을 열어주는 핵심 설정입니다.
set OLLAMA_ORIGINS=*

echo [2/3] AI 로컬 서버(Ollama)를 백그라운드에서 안전하게 시작합니다...
:: 명령 프롬프트 창을 더럽히지 않고 배경에서 실행되도록 합니다.
start /b ollama serve >nul 2>&1
:: 서버가 안정적으로 부팅될 때까지 3초간 잠시 대기합니다.
timeout /t 3 /nobreak >nul

echo [3/3] AI 분석 모델(seed1.5) 상태를 점검하고 프로그램을 실행합니다...
:: 처음 실행할 때는 모델을 생성하고, 이후 실행 시에는 무결성을 빠르게 체크합니다.
ollama create seed1.5 -f Modelfile >nul 2>&1

echo.
echo ========================================================
echo ✅ 모든 준비가 완료되었습니다!
echo 💡 이 검은색 창이 켜져 있는 동안 AI 기능이 활성화됩니다.
echo    (사용을 마치시면 이 창을 닫아주시면 됩니다.)
echo ========================================================
echo.

:: 메인 HTML 프로그램 자동 실행
start index.html